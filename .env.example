# Required for live X data. If unset, the site runs in demo mode.
# X_BEARER_TOKEN=

# Server
# PORT=3000
# DATA_DIR=./data

# Max original posts to fetch per handle (5–100). Lower = cheaper.
# MAX_POSTS=30

# Max uncached live X lookups per UTC day. Cached hits do not count.
# DAILY_CHECK_LIMIT=200
